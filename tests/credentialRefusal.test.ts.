import assert from 'node:assert/strict';
import { containsCredential, credentialRefusalMessage } from '../src/conversation';

function test(name: string, fn: () => void): void {
  try {
    fn();
    console.log(`ok - ${name}`);
  } catch (error) {
    console.error(`not ok - ${name}`);
    throw error;
  }
}

test('containsCredential detects plaintext password', () => {
  assert(containsCredential('my password is sunshine123'));
  assert(containsCredential('password is abc123'));
  assert(containsCredential('password: mysecret'));
});

test('containsCredential detects API key patterns', () => {
  assert(containsCredential('my API key is sk-ant-1234567890abcdef'));
  assert(containsCredential('sk-abcdefghijklmnopqrst'));
  assert(containsCredential('api_key is 1234567890abcdef'));
});

test('containsCredential detects token patterns', () => {
  assert(containsCredential('token is abc123xyz'));
  assert(containsCredential('my secret is topsecret'));
});

test('containsCredential does not flag normal messages', () => {
  assert(!containsCredential('remember that I like dark mode'));
  assert(!containsCredential('save my preferred reply style as concise'));
  assert(!containsCredential('I work at Anthropic'));
});

test('credentialRefusalMessage returns safe refusal', () => {
  const msg = credentialRefusalMessage();
  assert(msg.includes('cannot store'), 'Should say cannot store');
  assert(msg.includes('password manager'), 'Should suggest password manager');
  assert(!msg.includes('sunshine123'), 'Should not include example credentials');
});
