{
  "name": "spark-telegram-bot",
  "version": "1.0.0",
  "description": "Spark Telegram ingress gateway for Builder and Spawner",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "check:line-count": "python3 scripts/harness_checks/line_count_gate.py --root .",
    "sync:runtime": "node scripts/sync-runtime.cjs",
    "sync:check": "node scripts/sync-runtime.cjs --check",
    "build:sync": "npm run build && npm run sync:runtime",
    "deploy:doctor": "node scripts/deploy-doctor.mjs",
    "health:polling": "node scripts/run-health-polling.cjs",
    "health:runtime": "node scripts/run-health-runtime.cjs",
    "nl:live": "ts-node ops/liveNlCommandSuite.ts",
    "nl:harness-map": "ts-node ops/liveNlCommandSuite.ts --harness-map",
    "nl:verdict": "ts-node ops/liveNlVerdictReport.ts",
    "nl:replay": "ts-node ops/naturalRouteReplay.ts",
    "control:proof:audit": "ts-node ops/controlProofTraceAudit.ts",
    "control:proof:trace-join": "ts-node ops/controlProofTraceJoin.ts",
    "control:proof:live-trace": "ts-node ops/controlProofTraceJoin.ts --strict --require-live-evidence --min-route-rows 4 --min-no-action-rows 4",
    "control:proof:live-trace:prompts": "ts-node ops/controlProofTraceJoin.ts --safe-prompts",
    "control:proof:source-inventory": "ts-node ops/controlProofSourceInventory.ts --strict",
    "control:proof:capsules": "ts-node ops/controlProofCapsuleCoverage.ts",
    "control:proof:evals": "ts-node ops/controlProofReliabilityEvalCoverage.ts",
    "control:proof:legacy-prompts": "ts-node ops/controlProofLegacyPromptSurface.ts",
    "control:proof:capabilities": "ts-node ops/controlProofCapabilityEvidence.ts",
    "control:proof:surface": "ts-node ops/controlProofSurfaceEval.ts",
    "control:proof:render-firewall": "npm test -- --run tests/outboundSanitize.test.ts",
    "control:proof:reliability": "npm run control:proof:audit -- --sample 100 --fresh-strict && npm run control:proof:live-trace && npm run control:proof:source-inventory && npm run control:proof:render-firewall && npm run control:proof:capsules -- --strict && npm run control:proof:evals -- --strict && npm run control:proof:legacy-prompts -- --strict && npm run control:proof:capabilities -- --strict && npm run control:proof:surface -- --strict",
    "control:proof:panel": "ts-node ops/harnessProofPanel.ts",
    "control:proof:canaries": "ts-node ops/controlProofLiveCanaryPack.ts",
    "control:proof:repair:legacy": "ts-node ops/repairLegacyTraceProofGaps.ts",
    "control:proof:repair:outbound": "ts-node ops/repairOutboundTraceAudit.ts",
    "control:proof:repair:final-answer": "ts-node ops/repairFinalAnswerTraceAudit.ts",
    "control:proof:repair:route-confidence": "ts-node ops/repairRouteConfidenceTraceAudit.ts",
    "context:live": "ts-node ops/contextWindowLiveHarness.ts",
    "context:ux": "ts-node ops/contextWindowLiveHarness.ts --ux",
    "test": "node scripts/run-tests.cjs",
    "test:live-token": "node scripts/run-tests.cjs --require-real-token"
  },
  "keywords": [
    "telegram",
    "bot",
    "spark",
    "memory",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@spark/harness-core": "file:vendor/harness-core",
    "axios": "^1.16.1",
    "dotenv": "^17.2.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
